# 이 파일을 .env.local로 복사해서 쓰세요 (.env.local은 깃에 올라가지 않아요)

# API 서버 주소 (server/README.md: python -m uvicorn server.app:app --reload --port 8000)
# 비워 두면 서버 없이 예시 데이터(src/api/fixtures, server/examples와 같은 응답)로 화면이 동작해요
VITE_API_BASE=http://localhost:8000

# 서버 주소가 있어도 예시 데이터로 보고 싶을 때 true
VITE_API_MOCK=false
